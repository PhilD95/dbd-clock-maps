{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dbd-clock-maps",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
